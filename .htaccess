<FilesMatch "^(\.env|\.env\..*)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and preserve HTTP method/body (important for POST auth requests).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=307,L,NE]

  # Do not rewrite real files or directories.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/ [NC]

  # SPA fallback: always serve the compiled app entry.
  RewriteRule ^ index.html [QSA,L]
</IfModule>

  # Temporary caching policy to help deployments: reduce cache during updates
  # This forces browsers to revalidate or fetch updated assets immediately.
  <IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
      Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
      Header set Pragma "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
      Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
  </IfModule>

# Desactivar compresion para API
<FilesMatch "\.(php)$">
    SetEnv no-gzip 1
    Header set Content-Encoding identity
</FilesMatch>