<FilesMatch "^(\.env|\.env\..*)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and preserve HTTP method/body (important for POST auth requests).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=307,L,NE]

  # Do not rewrite real files or directories.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/ [NC]

  # SPA fallback: always serve the compiled app entry.
  RewriteRule ^ index.html [QSA,L]
</IfModule>