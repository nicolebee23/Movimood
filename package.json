{
  "name": "movimood",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.11.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build-validated": "react-scripts build && python validate_build.py",
    "watch-deploy": "chokidar \"src/**\" -c \"npm run build && python ftp_upload.py\" --initial",
    "backup-build": "powershell -NoLogo -ExecutionPolicy Bypass -Command \"$ts=Get-Date -Format 'yyyyMMdd_HHmmss'; Compress-Archive -Path build\\* -DestinationPath build_snapshot_$ts.zip\"",
    "deploy": "powershell -NoLogo -ExecutionPolicy Bypass -File deploy.ps1",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "proxy": "http://localhost/movimood-frontend",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0"
  }
}
